#!/usr/bin/env bash
# Site da Calu — hook de pre-commit
#
# Roda o gate da Definition of Done (typecheck de Astro/TS + ESLint + Prettier). A formatação é
# tratada como verificação somente-leitura, para que um commit desformatado seja rejeitado com uma
# dica clara em vez de reescrever silenciosamente a árvore de trabalho no meio do commit.
#
# Ativar: task hooks:install     (define core.hooksPath como .githooks)
# Pular uma vez: git commit --no-verify
set -euo pipefail

if ! command -v task >/dev/null 2>&1; then
  echo "pre-commit: 'task' não está instalado (veja mise.toml / rode 'mise install'). Pulando os checks de DOD." >&2
  exit 0
fi

echo "→ verificação de formatação"
if ! task fmt:check >/dev/null 2>&1; then
  echo "" >&2
  echo "✗ Há arquivos desformatados." >&2
  echo "  Rode: task fmt && git add -u" >&2
  exit 1
fi

echo "→ typecheck"
task typecheck >/dev/null

echo "→ lint"
task lint >/dev/null

echo "✓ checks de DOD aprovados"
