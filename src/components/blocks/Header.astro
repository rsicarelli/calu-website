---
/**
 * Header — lockup CaLu + nav desktop + ContactPair + ThemeToggle + MobileNav
 * (COMPONENTS.md § Header + MobileNav). Documentado como um bloco só no handoff; aqui, dois
 * arquivos por testabilidade — `MobileNav.astro` concentra o botão "Menu", o painel e o script
 * que os une.
 *
 * Props
 *   navLinks  itens do nav principal (desktop + mobile), na ordem em que aparecem.
 *   …         qualquer outro atributo de `<header>` é repassado (COMPONENTS.md: "todo
 *             componente aceita `class` e repassa atributos").
 *
 * Sticky com fundo SÓLIDO (`bg-bg`), nunca translúcido (COMPONENTS.md § Header). `min-h-header`
 * é o MESMO token que alimenta `scroll-padding-top` em `global.css` §3 — usar aqui garante que
 * a altura real do header e o orçamento de rolagem nunca divirjam (ver o comentário do token).
 *
 * O medalhão sai com `alt=""`: o texto "CaLu" ao lado do link já nomeia o link inteiro, então o
 * `<img>` é decorativo (texto alternativo que só repetiria o nome do link é redundante, não
 * informativo). `width`/`height` explícitos são o que zera o CLS. A arte fica DENTRO de um `span`
 * `bg-surface-deep` (52px, círculo) — o próprio traço é creme/dourado sobre fundo removido,
 * desenhado para pousar sobre superfície escura (ver o comentário junto ao `<span>` abaixo).
 *
 * Tipagem: `Props extends HTMLAttributes<'header'>`, não genérica — mesmo teto documentado em
 * `Container.astro` (o conversor de TSX do `@astrojs/compiler` 2.13.1 estoura em `Props`
 * genérica acima de ~3KB de arquivo). `<header>` é a única tag plausível aqui, então o teto não
 * aperta em uso real.
 */
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

import logoMark from '@/assets/brand/logo-mark.png';
import Container from '@/components/ui/Container.astro';
import ContactPair from '@/components/ui/ContactPair.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { SITE } from '@/lib/site';

import MobileNav from './MobileNav.astro';

export interface NavLink {
  href: string;
  label: string;
}

interface Props extends HTMLAttributes<'header'> {
  /** Itens do nav principal (desktop + mobile), na ordem de exibição. */
  navLinks: NavLink[];
}

const { navLinks, class: className, ...rest } = Astro.props;
---

{
  /* A linha de baixo não é decisão nova: o orçamento de `--spacing-header` (§3 do global.css) já
     soma "1px da linha inferior" nos 77px que arredonda para 88px — ela foi orçada e nunca
     desenhada. Todas as 11 telas do mockup a trazem. Sem ela o header sticky não tem separação
     nenhuma do conteúdo que rola por baixo.
     `--color-line-strong` bate o #16201C do mockup no claro; no escuro é o sage #748268 onde o
     mockup pôs #2E3C33 — mais visível que o mockup, coerente com o papel documentado do token
     ("régua de abertura de seção"). */
}
<header
  class:list={['sticky top-0 z-30 flex min-h-header border-b border-line-strong bg-bg', className]}
  {...rest}
>
  <Container width="page" class="flex items-center justify-between gap-4">
    {
      /* `min-w-0` NO LOCKUP, e é a 1.4.10 a 320px, não polimento.

        Item de flex nasce com `min-width: auto`, que o proíbe de encolher abaixo do próprio
        conteúdo intrínseco. "Pilates e Fisioterapia" em 17px pede ~160px numa linha só; a 320px o
        `container-page` deixa 280px, o botão "Menu" toma 85px, e o lockup exigia mais do que
        sobrava. O resultado era o cabeçalho medindo 352px numa tela de 320 — barra de rolagem
        horizontal em TODA página do site, `PAGES.md:30` reprovado, e nenhum teste vermelho, porque
        até a Fase 5 nada media geometria renderizada.

        Com `min-w-0` o item pode encolher e o subtítulo quebra em duas linhas, que é o
        comportamento de refluxo que a norma pede. Nada muda a partir de 360px, onde já cabia. */
    }
    <a href="/" class="inline-flex min-w-0 items-center gap-3">
      {
        /* O medalhão do mockup NUNCA é a arte crua: é um círculo `surface-deep` (52px,
           `COMPONENTS.md` § Header) com o símbolo MENOR (44px) centralizado dentro — a mesma
           relação nas 11 telas do handoff, com um pouco de fundo escuro respirando ao redor da
           linha fina. `logo-mark.png` é a arte com fundo removido (`design_handoff_calu/
           CLAUDE.md` § Cor: "lettering creme #EDE7D9… dourado #C9A45C"), desenhada para pousar
           SOBRE esse fundo escuro — sem ele, o traço creme/dourado cai quase invisível sobre o
           `bg-bg` claro (creme sobre creme) e, mesmo no escuro, a arte ocupava o círculo INTEIRO
           sem a folga que o desenho pressupõe, encostando na borda do próprio `rounded-full`. Um
           span `bg-surface-deep` fixo funciona nos dois temas sem `dark:` (o token já é escuro
           nos dois — `#16211B` no claro bate o hex do mockup, `#1C2822` no escuro), coerente com
           "trocar de tema é trocar o valor da mesma custom property" (CLAUDE.md § Stack). */
      }
      <span
        class="flex size-target shrink-0 items-center justify-center rounded-full bg-surface-deep"
      >
        <Image src={logoMark} alt="" width={44} height={44} densities={[1, 2, 3]} class="size-11" />
      </span>
      <span>
        <span class="text-lockup font-semibold text-ink">CaLu</span>
        <span class="block text-small text-ink-muted">Pilates e Fisioterapia</span>
      </span>
    </a>

    {
      /* `px-3.5` + `rounded-control` + `hover:bg-surface-alt` restauram o "chip" do nav do
         mockup (`padding:0 14px`, raio 4, hover `#EDE7D9` = `--color-surface-alt` — Calu -
         Direcao de Marca.dc.html, header desktop). Sem eles o link era texto nu (só `gap-6`
         entre as palavras), o único controle do header sem nenhum respiro interno — ao lado do
         par de contato (mesmo problema) e do WhatsAppFab/ThemeToggle, que sempre tiveram `px-5`.
         `gap-1` (4px) substitui o `gap-6` (24px): o respiro agora vem do padding de cada link,
         não do vão entre eles — o mesmo `gap:4px` do mockup. */
    }
    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="inline-flex min-h-target items-center rounded-control px-3.5 font-body text-body text-ink transition-colors duration-150 hover:bg-surface-alt"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <ContactPair
        whatsappHref={SITE.whatsapp.href}
        phoneHref={SITE.phone.href}
        phoneLabel={SITE.phone.label}
        size="small"
        class="text-ink"
      />
    </div>

    {
      /* ThemeToggle já nasce com `inline-flex` no PRÓPRIO template (base classes do
         componente) — incondicional, nunca `md:`. Passar `class="hidden md:inline-flex"` para
         dentro do componente empata as duas utilities de `display` em especificidade (0,1,0)
         cada, e quem decide o empate é a ORDEM no CSS gerado, não a ordem escrita na tag: medido
         ao vivo (Playwright + CDP `CSS.getMatchedStylesForNode`) que `.inline-flex` sai DEPOIS de
         `.hidden` na folha final, então `.inline-flex` vencia sempre — o botão "Tema escuro"
         ficava visível em TODA largura, inclusive lado a lado com o "Menu" do MobileNav abaixo de
         900px (as duas pílulas se sobrepunham, texto cortado). O `<div>` a seguir é o MESMO
         padrão já usado duas seções acima para o `ContactPair`: a visibilidade mora num
         contêiner que não carrega nenhuma outra utility de `display` para competir, e o
         componente por dentro mantém as classes que já eram dele. */
    }
    <div class="hidden md:block">
      <ThemeToggle />
    </div>

    <MobileNav
      navLinks={navLinks}
      whatsappHref={SITE.whatsapp.href}
      phoneHref={SITE.phone.href}
      phoneLabel={SITE.phone.label}
      class="md:hidden"
    />
  </Container>
</header>
