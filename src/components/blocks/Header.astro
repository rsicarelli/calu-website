---
/**
 * Header — lockup CaLu + nav desktop + ContactPair + ThemeToggle + MobileNav
 * (COMPONENTS.md § Header + MobileNav). Documentado como um bloco só no handoff; aqui, dois
 * arquivos por testabilidade — `MobileNav.astro` concentra o botão "Menu", o painel e o script
 * que os une.
 *
 * Props
 *   navLinks  itens do nav principal (desktop + mobile), na ordem em que aparecem.
 *   …         qualquer outro atributo de `<header>` é repassado (COMPONENTS.md: "todo
 *             componente aceita `class` e repassa atributos").
 *
 * Sticky com fundo SÓLIDO (`bg-bg`), nunca translúcido (COMPONENTS.md § Header). `min-h-header`
 * é o MESMO token que alimenta `scroll-padding-top` em `global.css` §3 — usar aqui garante que
 * a altura real do header e o orçamento de rolagem nunca divirjam (ver o comentário do token).
 *
 * O medalhão sai com `alt=""`: o texto "CaLu" ao lado do link já nomeia o link inteiro, então o
 * `<img>` é decorativo (texto alternativo que só repetiria o nome do link é redundante, não
 * informativo). `width`/`height` explícitos são o que zera o CLS.
 *
 * Tipagem: `Props extends HTMLAttributes<'header'>`, não genérica — mesmo teto documentado em
 * `Container.astro` (o conversor de TSX do `@astrojs/compiler` 2.13.1 estoura em `Props`
 * genérica acima de ~3KB de arquivo). `<header>` é a única tag plausível aqui, então o teto não
 * aperta em uso real.
 */
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

import logoMark from '@/assets/brand/logo-mark.png';
import Container from '@/components/ui/Container.astro';
import ContactPair from '@/components/ui/ContactPair.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { SITE } from '@/lib/site';

import MobileNav from './MobileNav.astro';

export interface NavLink {
  href: string;
  label: string;
}

interface Props extends HTMLAttributes<'header'> {
  /** Itens do nav principal (desktop + mobile), na ordem de exibição. */
  navLinks: NavLink[];
}

const { navLinks, class: className, ...rest } = Astro.props;
---

{
  /* A linha de baixo não é decisão nova: o orçamento de `--spacing-header` (§3 do global.css) já
     soma "1px da linha inferior" nos 77px que arredonda para 88px — ela foi orçada e nunca
     desenhada. Todas as 11 telas do mockup a trazem. Sem ela o header sticky não tem separação
     nenhuma do conteúdo que rola por baixo.
     `--color-line-strong` bate o #16201C do mockup no claro; no escuro é o sage #748268 onde o
     mockup pôs #2E3C33 — mais visível que o mockup, coerente com o papel documentado do token
     ("régua de abertura de seção"). */
}
<header
  class:list={['sticky top-0 z-30 min-h-header border-b border-line-strong bg-bg', className]}
  {...rest}
>
  <Container width="page" class="flex h-full items-center justify-between gap-4">
    {
      /* `min-w-0` NO LOCKUP, e é a 1.4.10 a 320px, não polimento.

        Item de flex nasce com `min-width: auto`, que o proíbe de encolher abaixo do próprio
        conteúdo intrínseco. "Pilates e Fisioterapia" em 17px pede ~160px numa linha só; a 320px o
        `container-page` deixa 280px, o botão "Menu" toma 85px, e o lockup exigia mais do que
        sobrava. O resultado era o cabeçalho medindo 352px numa tela de 320 — barra de rolagem
        horizontal em TODA página do site, `PAGES.md:30` reprovado, e nenhum teste vermelho, porque
        até a Fase 5 nada media geometria renderizada.

        Com `min-w-0` o item pode encolher e o subtítulo quebra em duas linhas, que é o
        comportamento de refluxo que a norma pede. Nada muda a partir de 360px, onde já cabia. */
    }
    <a href="/" class="inline-flex min-w-0 items-center gap-3">
      <Image src={logoMark} alt="" width={52} height={52} class="size-target rounded-full" />
      <span>
        <span class="text-lockup font-semibold text-ink">CaLu</span>
        <span class="block text-small text-ink-muted">Pilates e Fisioterapia</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="inline-flex min-h-target items-center font-body text-body text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <ContactPair
        whatsappHref={SITE.whatsapp.href}
        phoneHref={SITE.phone.href}
        phoneLabel={SITE.phone.label}
        size="small"
        class="text-ink"
      />
    </div>

    <ThemeToggle class="hidden md:inline-flex" />

    <MobileNav
      navLinks={navLinks}
      whatsappHref={SITE.whatsapp.href}
      phoneHref={SITE.phone.href}
      phoneLabel={SITE.phone.label}
      class="md:hidden"
    />
  </Container>
</header>
