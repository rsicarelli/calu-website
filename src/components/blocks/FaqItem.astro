---
/**
 * FaqItem — uma pergunta e sua resposta, com `<details>`/`<summary>` nativo
 * (COMPONENTS.md § FaqAccordion / FaqItem).
 *
 * Props
 *   question    o texto da pergunta.
 *   questionAs  tag do cabeçalho DENTRO do `<summary>` — padrão `h3`. A `/lab` passa `h4`/`h5`
 *               porque lá a seção já gastou níveis; numa página real o padrão serve.
 *   answer      o texto da resposta, quando ela é uma frase só. Ignorado se houver slot.
 *   open        item já aberto ao carregar. O primeiro de cada grupo abre.
 *   slot        a resposta como conteúdo rico. Ver abaixo.
 *   …           qualquer outro atributo válido para `<details>` é repassado à raiz.
 *
 * DUAS FORMAS DE RESPOSTA, e a segunda nasceu na Fase 4. Até aqui a resposta era sempre uma
 * string — servia para a `/lab`, cujo texto é ilustrativo. Com content collections, a resposta
 * real vive no CORPO MARKDOWN da entrada, e corpo markdown não é string: é um componente que o
 * `render()` do `astro:content` devolve. Por isso o slot, e por isso `answer` virou opcional.
 * Quando há slot, ele ganha; o `<p>` do `answer` nem é renderizado, para não sair parágrafo
 * vazio ao lado do conteúdo.
 *
 * O slot sai dentro de `[data-prose]` — é o que faz a regra `:where([data-prose]) a` de
 * `global.css` §7 sublinhar link de texto corrido (regra 9 do DESIGN-SYSTEM: link em texto
 * corrido é sublinhado, não só colorido). O `answer` string não precisa: é uma frase, sem link.
 *
 * NATIVO, não botão + `aria-expanded`/`aria-controls`. Os dois padrões são mutuamente exclusivos,
 * e o nativo funciona sem JavaScript — coerente com o inviolável "nada depende de framework JS
 * para funcionar". O trade-off era menos controle sobre a animação de abrir e fechar; deixou de
 * ser aceito quando o resultado ficou "frio" demais na prática. A correção não abandona o nativo:
 * é o mesmo padrão de `<script>` vanilla que já rege `ThemeToggle`/`MobileNav` (CLAUDE.md § Stack:
 * "interação... é `<script>` vanilla"). Ele escuta o `click` do `<summary>` ANTES do toggle nativo
 * acontecer (`preventDefault`), anima a altura do painel com a Web Animations API, e só seta
 * `details.open` no fim da transição — o estado real de aberto/fechado continua sendo o atributo
 * `open` do próprio `<details>`; a animação é só o percurso visual até ele chegar lá.
 * `prefers-reduced-motion` pula a animação e aplica o estado final direto, sem transição.
 *
 * O ANINHAMENTO É O MOTIVO DE ESTE COMPONENTE EXISTIR. `<details><summary><h_>` — o cabeçalho
 * DENTRO do summary, nunca o contrário. O handoff pedia o inverso e o inverso não funciona: o
 * modelo de conteúdo de `<details>` exige `<summary>` como PRIMEIRO FILHO, então com um cabeçalho
 * no meio o elemento fica sem summary nenhum, o navegador sintetiza o próprio marcador, e o texto
 * da pergunta some junto com a resposta quando o item está fechado. A Fase 2 corrigiu isso no
 * handoff e travou com teste; aqui a correção vira estrutura — não há como escrever errado.
 *
 * EXCLUSIVO DENTRO DO GRUPO — decisão revertida. A versão original não usava atributo `name` de
 * propósito ("quem chega com duas dúvidas quer ler as duas"); o pedido explícito passou a ser
 * abrir uma pergunta fechar as outras, pra o acordeão ler como um fluxo guiado em vez de uma pilha
 * de blocos soltos. `name` nativo não serve pra isso sozinho: ele vale pra PÁGINA inteira, e
 * `FaqGroup` tem quatro usos reais — os três grupos de `/duvidas` MAIS o resumo da Home — que
 * precisam de exclusividade independente por grupo, não uma exclusividade global que cruzaria
 * grupos sem relação nenhuma entre si. Por isso a exclusividade mora no mesmo `<script>` do
 * parágrafo acima: ao abrir um item, ele fecha (animando) todo `[data-faq-item][open]` irmão
 * dentro do `[data-faq-group]` mais próximo — nunca além dele.
 *
 * O painel fechado sai do fluxo pelo comportamento NATIVO do elemento. Nunca `height: 0` com
 * `overflow: hidden` como estado PERMANENTE, que deixaria a resposta alcançável por Tab e por
 * leitor de tela mesmo invisível — é por isso que a resposta é conteúdo do componente e não um
 * slot livre. A animação do `<script>` usa `height`/`overflow` inline, mas só como trânsito: no
 * fechamento, `details.open` só vira `false` quando a transição termina, nunca antes — não existe
 * quadro onde o conteúdo está invisível e ainda assim alcançável.
 *
 * Tipagem: `Props extends HTMLAttributes<'details'>`, não genérica em `as` — ver o comentário
 * equivalente em `Container.astro`. A raiz é sempre um `<details>`.
 *
 *   <FaqItem open question="Preciso de pedido médico?" answer="Não é obrigatório…" />
 *   <FaqItem questionAs="h5" question="…" answer="…" />
 *
 * Quando NÃO usar: para conteúdo que precisa estar sempre visível. Resposta escondida atrás de um
 * clique é decisão editorial, não de layout.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';

interface Props extends HTMLAttributes<'details'> {
  /** Texto da pergunta. */
  question: string;
  /** Tag do cabeçalho dentro do `<summary>` — padrão `'h3'`. */
  questionAs?: HTMLTag;
  /** Texto da resposta, quando é uma frase só. Ignorado se houver slot. */
  answer?: string;
  /** Item aberto ao carregar — o primeiro de cada grupo. */
  open?: boolean;
}

const {
  question,
  questionAs: Heading = 'h3',
  answer,
  open = false,
  class: className,
  ...rest
} = Astro.props;

/* Ver `Action.astro`: o spread do Astro prevalece sobre o atributo literal, então o descarte
   precisa ser explícito. Identidade não é prop. */
delete rest['data-faq-item'];

const hasRichAnswer = Astro.slots.has('default');

/* Sufixo `Class` de propósito: é o que faz `scripts/check-utilities.mjs` enxergar estes literais
   (ver "REGIÃO EXTRA" no cabeçalho do gate). */
const summaryClass = 'flex min-h-target cursor-pointer items-center justify-between gap-4 py-4';
const answerClass = 'max-w-answer pb-4 text-body text-ink-body';
/* O sinal +/− em `--calu-accent` que `COMPONENTS.md § FaqAccordion` pede, e que faltava: sem
   ele a pergunta lia como texto estático, sem nenhuma pista de que abre. Dois nós de TEXTO de
   verdade alternados por CSS, e não `content:` gerado — o Chrome expõe `::after` à árvore de
   acessibilidade, e um `<span aria-hidden>` não deixa dúvida. */
const signClass = 'shrink-0 text-h3 text-accent';
---

{
  /* `data-faq-item` — identificador estável, sem valor: estado visual único, e `open` é runtime,
     não identidade. Os `data-faq-sign-*` abaixo são gancho de CSS nos glifos, não identidade da
     raiz; não confundir os dois papéis (ver `BrandPlaceholder.astro`).

     O descarte em `rest` acima é o que impede o chamador de reetiquetar o item: ordem de atributo
     não basta, o spread do Astro prevalece sobre o literal (ver `Action.astro`). */
}
<details data-faq-item open={open} {...rest} class:list={['border-t border-line-soft', className]}>
  <summary class={summaryClass}>
    <Heading class="text-question text-ink">{question}</Heading>
    <span aria-hidden="true" data-faq-sign-closed class={signClass}>+</span>
    <span aria-hidden="true" data-faq-sign-open class={signClass}>−</span>
  </summary>
  {
    hasRichAnswer ? (
      <div data-prose class={answerClass}>
        <slot />
      </div>
    ) : (
      <p class={answerClass}>{answer}</p>
    )
  }
</details>

<style>
  /* O marcador nativo sai nos dois motores: `list-style` cobre Firefox e o Chrome moderno,
     `::-webkit-details-marker` cobre Safari e o Chrome antigo. Sem isto o triângulo do
     navegador conviveria com o sinal +/− do handoff. */
  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details:not([open]) [data-faq-sign-open],
  details[open] [data-faq-sign-closed] {
    display: none;
  }
</style>

<script>
  // Idempotente por item: mesmo padrão de MobileNav.astro/ThemeToggle.astro — sobrevive a
  // qualquer reexecução futura do módulo. Um `<script>` só, deduplicado pelo Astro
  // independentemente de quantos `FaqItem` a página renderizar.
  (() => {
    const REDUCE_MOTION = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION_MS = 220;
    const inflight = new WeakMap<HTMLElement, Animation>();

    function panelOf(details: HTMLDetailsElement): HTMLElement | null {
      return details.querySelector<HTMLElement>(':scope > summary + *');
    }

    function animate(panel: HTMLElement, from: string, to: string, onFinish: () => void) {
      inflight.get(panel)?.cancel();
      panel.style.overflow = 'hidden';
      const animation = panel.animate(
        { height: [from, to] },
        { duration: DURATION_MS, easing: 'ease' },
      );
      inflight.set(panel, animation);
      animation.onfinish = () => {
        panel.style.overflow = '';
        panel.style.height = '';
        onFinish();
      };
    }

    function openItem(details: HTMLDetailsElement) {
      const panel = panelOf(details);
      details.open = true;
      if (!panel || REDUCE_MOTION) return;
      const target = panel.getBoundingClientRect().height;
      animate(panel, '0px', `${target}px`, () => {});
    }

    function closeItem(details: HTMLDetailsElement) {
      const panel = panelOf(details);
      if (!panel || REDUCE_MOTION) {
        details.open = false;
        return;
      }
      const start = panel.getBoundingClientRect().height;
      animate(panel, `${start}px`, '0px', () => {
        details.open = false;
      });
    }

    document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach((details) => {
      const summary = details.querySelector<HTMLElement>(':scope > summary');
      if (!summary || details.dataset.faqBound === 'true') return;
      details.dataset.faqBound = 'true';

      summary.addEventListener('click', (event) => {
        event.preventDefault();
        if (details.open) {
          closeItem(details);
          return;
        }
        details
          .closest<HTMLElement>('[data-faq-group]')
          ?.querySelectorAll<HTMLDetailsElement>('[data-faq-item][open]')
          .forEach((sibling) => {
            if (sibling !== details) closeItem(sibling);
          });
        openItem(details);
      });
    });
  })();
</script>
