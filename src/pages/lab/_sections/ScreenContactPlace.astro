---
/**
 * Blocos "Onde estamos" e "Como é chegar aqui" (mockup §07, parte de baixo).
 *
 * O mapa é uma IMAGEM ESTÁTICA na proporção 3/2, nunca um embed interativo: embed custa JavaScript
 * de terceiro, mede CLS e traz rastreamento junto — três coisas que este projeto não aceita numa
 * página institucional. Sem imagem de mapa, entra o fallback de marca na mesma proporção, e a
 * altura não colapsa.
 *
 * "Como é chegar aqui" aceita de 2 a 8 itens do CMS e fecha SEMPRE com o convite a avisar antes de
 * vir — é o que transforma uma lista de características em uma oferta de ajuda. Aqui aparece com a
 * quantidade típica; os extremos de 2 e 8 ficam em `Resilience.astro`.
 */

import BrandPlaceholder from '@/components/ui/BrandPlaceholder.astro';
import ContactPair from '@/components/ui/ContactPair.astro';
import { SITE } from '@/lib/site';
import RuledList from '@/components/ui/RuledList.astro';
---

<div class="container-page mt-8 grid gap-8 md:grid-cols-2">
  <div>
    <p class="label text-ink-muted">Onde estamos — mapa estático 3/2</p>
    <h3 class="mt-4 text-h3 text-ink">Onde estamos</h3>
    <BrandPlaceholder ratio="3/2" class="mt-4" />
    <p class="mt-4 text-body text-ink-body">{SITE.addressLine}</p>
    <p class="mt-4 text-body text-ink-body">{SITE.hoursLine}</p>
    <ContactPair
      class="mt-4"
      whatsappHref={SITE.whatsapp.href}
      phoneHref={SITE.phone.href}
      phoneLabel={SITE.phone.label}
    />
  </div>

  <div>
    <p class="label text-ink-muted">Como é chegar aqui</p>
    <h3 class="mt-4 text-h3 text-ink">Como é chegar aqui</h3>
    <RuledList
      class="mt-4"
      items={[
        'Entrada sem degrau',
        'Elevador no prédio',
        'Banheiro adaptado',
        'Estacionamento nas proximidades',
        'Estação de metrô a curta caminhada',
        'Acompanhante pode entrar junto',
      ]}
    />
    <p class="mt-8 text-body font-semibold text-ink">
      Precisa de alguma adaptação? Avise antes, a gente organiza.
    </p>
  </div>
</div>
