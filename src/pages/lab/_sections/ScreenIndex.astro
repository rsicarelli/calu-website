---
/**
 * Tela "Índice de serviços" (mockup §09) — o bloco de escolha, a lista de cards, e o estado vazio.
 *
 * O BLOCO "Não sabe qual escolher?" vem ANTES da lista, e não é enfeite: o público chega com uma
 * queixa em português comum ("estou com dor no ombro"), não com o nome técnico do atendimento.
 * Forçar a escolha antes de conversar é o jeito mais fácil de perder o contato.
 *
 * Os cards usam o bloco `ServiceCard`, que é dono da ordem obrigatória (frase comum → nome
 * técnico → descrição → ação) e do link estendido. As dez ocorrências que existiam aqui, na home,
 * no template de serviço e na seção de resiliência viraram chamadas; o porquê de cada regra está
 * no cabeçalho de `src/components/blocks/ServiceCard.astro`.
 *
 * O ESTADO VAZIO usa o `EmptyState` de verdade, o mesmo componente da `/404`. É o que a página
 * mostra quando o CMS não tem nenhum serviço cadastrado — situação garantida no dia em que a
 * cliente começar a editar.
 */

import CtaBlock from '@/components/blocks/CtaBlock.astro';
import ServiceCard from '@/components/blocks/ServiceCard.astro';
import EmptyState from '@/components/blocks/EmptyState.astro';
import { SITE } from '@/lib/site';
---

<div class="container-page mt-8 flex flex-col gap-12">
  <div>
    <h3 class="text-h1 text-ink">O que a gente atende</h3>

    <CtaBlock
      class="mt-8"
      headingAs="h4"
      heading="Não sabe qual escolher?"
      message="Não precisa saber o nome do atendimento. Conte o que está sentindo e a gente ajuda a entender por onde começar."
      whatsappHref={SITE.whatsapp.href}
      phoneHref={SITE.phone.href}
      phoneLabel={SITE.phone.label}
    />
  </div>

  <div>
    <p class="label text-ink-muted">Lista — linha na tela larga, coluna no celular</p>
    <ul class="mt-4 flex flex-col border-t border-line-strong">
      <ServiceCard
        eyebrow="Estou com dor em algum lugar"
        title="Fisioterapia"
        titleAs="h4"
        description="Avaliação, plano e acompanhamento para queixa de dor ou limitação de movimento."
        href="/servicos"
        layout="row"
      />

      <ServiceCard
        eyebrow="Quero me mexer com orientação"
        title="Pilates clínico"
        titleAs="h4"
        description="Exercício conduzido em turma pequena, com o plano ajustado ao que a avaliação mostrou."
        href="/servicos"
        layout="row"
      />

      <li class="flex flex-col gap-4">
        <p class="label text-ink-muted">Sem imagem cadastrada · título de três linhas</p>
        <ServiceCard
          as="div"
          eyebrow="Vou operar, ou acabei de operar"
          title="Acompanhamento no pós-operatório de ombro, joelho e coluna"
          titleAs="h4"
          description="Retomada gradual de movimento, no ritmo combinado com quem indicou a cirurgia."
          href="/servicos"
          media={false}
        />
      </li>
    </ul>
  </div>

  <div>
    <p class="label text-ink-muted">Estado vazio — o CMS sem nenhum serviço cadastrado</p>
    <div class="mt-4 rounded-card border border-line-soft p-6">
      <EmptyState
        headingAs="h4"
        heading="Estamos organizando esta página"
        message="Enquanto isso, fale com a gente: dá para explicar o que está sentindo e a gente ajuda a entender o caminho."
        whatsappHref={SITE.whatsapp.href}
        phoneHref={SITE.phone.href}
        phoneLabel={SITE.phone.label}
      />
    </div>
  </div>
</div>
