      </li>
      <li class="flex items-center gap-4">
        <span class="size-target shrink-0 rounded-control border border-line-soft bg-disabled-ink"
        ></span>
        <span class="text-small text-ink"
          >disabled-ink<br /><span class="text-ink-muted">texto de controle inativo</span></span
        >
      </li>
      <li class="flex items-center gap-4">
        <span class="size-target shrink-0 rounded-control border border-line-soft bg-field-bg"
        ></span>
        <span class="text-small text-ink"
          >field-bg<br /><span class="text-ink-muted">fundo de campo</span></span
        >
      </li>
      <li class="flex items-center gap-4">
        <span class="size-target shrink-0 rounded-control border border-line-soft bg-field-border"
        ></span>
        <span class="text-small text-ink"
          >field-border<br /><span class="text-ink-muted">borda de campo</span></span
        >
      </li>
    </ul>
  </div>
</div>
